+/* Vibration is sent by its own thread. HidD_SetOutputReport is a synchronous
+ * write to the device (a USB or wireless round trip, often several ms), and
+ * XInputSetState used to make it with the controller locked: the game waited
+ * for it, and so did the update thread that reads the controller's input,
+ * which then reached the game late (games set vibration on every shot).
+ * XInputSetState now records the latest vibration and returns; the rumble
+ * thread sends it outside the controller lock, on its own handle, and only the
+ * newest value if several came in during a write. */
+static CRITICAL_SECTION rumble_crit;
+static CRITICAL_SECTION_DEBUG rumble_crit_debug =
+{
+    0, 0, &rumble_crit,
+    { &rumble_crit_debug.ProcessLocksList, &rumble_crit_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": rumble_crit") }
+};
+static CRITICAL_SECTION rumble_crit = { &rumble_crit_debug, -1, 0, 0, 0, 0 };
+static HANDLE rumble_event;
+static struct
+{
+    BOOL pending;
+    XINPUT_VIBRATION vibration;
+} rumble[XUSER_MAX_COUNT];
 
+static void rumble_send(DWORD index, XINPUT_VIBRATION *vibration)
+{
+    struct xinput_controller *controller = &controllers[index];
+    HANDLE device = NULL;
+    char *report_buf;
+    ULONG report_len;
+
+    if (!controller_lock(controller)) return;
+    report_len = controller->hid.caps.OutputReportByteLength;
+    if ((report_buf = malloc(report_len)) && HID_prepare_state(controller, vibration, report_buf) &&
+        !DuplicateHandle(GetCurrentProcess(), controller->device, GetCurrentProcess(), &device, 0, FALSE,
+                         DUPLICATE_SAME_ACCESS))
+        device = NULL;
+    controller_unlock(controller);
+
+    if (device)
+    {
+        if (!HidD_SetOutputReport(device, report_buf, report_len))
+            WARN("HidD_SetOutputReport failed with error %lu\n", GetLastError());
+        CloseHandle(device);
+    }
+    free(report_buf);
+}
+
+static DWORD WINAPI rumble_thread_proc(void *param)
+{
+    XINPUT_VIBRATION vibration;
+    BOOL pending;
+    DWORD i;
+
+    SetThreadDescription(GetCurrentThread(), L"wine_xinput_rumble");
+
+    for (;;)
+    {
+        WaitForSingleObject(rumble_event, INFINITE);
+        for (i = 0; i < XUSER_MAX_COUNT; ++i)
+        {
+            EnterCriticalSection(&rumble_crit);
+            pending = rumble[i].pending;
+            vibration = rumble[i].vibration;
+            rumble[i].pending = FALSE;
+            LeaveCriticalSection(&rumble_crit);
+            if (pending) rumble_send(i, &vibration);
+        }
+    }
+    return 0;
+}
+
+static BOOL WINAPI start_rumble_thread_once(INIT_ONCE *once, void *param, void **context)
+{
+    HMODULE module;
+    HANDLE thread;
+
+    if (!(rumble_event = CreateEventW(NULL, FALSE, FALSE, NULL))) return FALSE;
+    /* The thread keeps the module loaded, as the update thread does. */
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (void *)rumble_thread_proc, &module))
+        return FALSE;
+    if (!(thread = CreateThread(NULL, 0, rumble_thread_proc, NULL, 0, NULL)))
+    {
+        FreeLibrary(module);
+        return FALSE;
+    }
+    CloseHandle(thread);
+    return TRUE;
+}
